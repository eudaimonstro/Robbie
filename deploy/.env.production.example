# Robbie's production settings. On the server: cp .env.production.example .env && chmod 600 .env,
# then fill in the blanks (docs/deploy.md). Compose reads this file for the values in
# compose.yaml, and the app reads it as its environment.

# --- The server and its image -----------------------------------------------------------------
# The address Caddy gets a certificate for. Its DNS A record points at this server, DNS only.
ROBBIE_DOMAIN=robbie.scouch.dev
# Let's Encrypt writes here about certificate problems. Required.
ACME_EMAIL=
# The image to run. :main is the latest build of main; a :sha-<7 hex> tag holds a release or
# rolls one back (docs/deploy.md, "Rollback").
ROBBIE_IMAGE=ghcr.io/eudaimonstro/robbie:main

# --- The database -----------------------------------------------------------------------------
# The robbie user's password. Required. Letters and digits only, since it goes into a URL:
# openssl rand -hex 24
POSTGRES_PASSWORD=
# Compose sets DATABASE_URL from it (postgresql://robbie:<password>@db:5432/robbie); don't set
# DATABASE_URL here. DIRECT_URL stays unset: the Prisma CLI then uses DATABASE_URL.
# DATABASE_SSL stays unset: "db" is a container on the compose network, reached without TLS
# and never published. (disable, require or verify are for a hosted database.)

# --- The server's secret ---------------------------------------------------------------------
# The key of the server's keyed hashes (the network addresses sign-in codes record). Required,
# at least 32 characters: openssl rand -hex 32. Changing it only resets the hourly sign-in
# limits.
SERVER_SECRET=

# --- Addresses --------------------------------------------------------------------------------
# The web app's address, for the links in emails. Required.
APP_URL=https://robbie.scouch.dev
# Leave CLIENT_ORIGIN unset: the web app is served from the API's own origin, so no other origin
# may call the API.
# CLIENT_ORIGIN=

# --- Email: sign-in codes and added-to-organization notices -----------------------------------
# The sender, on the domain verified with the provider. Required.
EMAIL_FROM=Robbie <noreply@robbie.scouch.dev>
# One provider is required. Resend sends over HTTPS, which this droplet allows (DigitalOcean
# blocks outbound SMTP on ports 465 and 587). Use a sending-only key for robbie.scouch.dev.
RESEND_API_KEY=
# Alternatives on another host (if several are set, SendGrid wins, then Resend, then SMTP):
# SENDGRID_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# --- Uploaded files ---------------------------------------------------------------------------
# Each organization's uploaded files (meeting attachments) together, in megabytes. An upload past
# it is refused. 500 by default; a whole number above 0.
# ORG_STORAGE_LIMIT_MB=500

# --- Logging ----------------------------------------------------------------------------------
# info by default in production; warn is quieter, debug is noisy
# LOG_LEVEL=info

# --- Backups: the backup service --------------------------------------------------------------
# The hour (UTC) after which each day's backup runs: 9 is 3 or 4 a.m. in Chicago
BACKUP_HOUR_UTC=9
# Days of backups kept in deploy/backups
BACKUP_KEEP_DAYS=14
# Who owns the backup files on the host, as uid:gid (id -u deploy and id -g deploy), so they can
# be copied off the server without sudo
BACKUP_OWNER=1000:1000

# --- Set by compose or the image; never set them here -----------------------------------------
# NODE_ENV=production, PORT=3001, TRUST_PROXY=1 (Caddy is one proxy), UPLOAD_DIR=/data/uploads,
# PRESERVE_DIR=/data/preserved (reported files, docs/deploy.md "Handling a report")

# --- Never in production ----------------------------------------------------------------------
# ENABLE_TEST_AUTH and TEST_VERIFICATION_CODE let a fixed code sign in any email. The server
# refuses to start in production with ENABLE_TEST_AUTH=true.
