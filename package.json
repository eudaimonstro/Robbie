{
  "name": "robbie-bylawyer",
  "version": "1.0.0",
  "private": true,
  "description": "Combined parliamentary procedure application with bylaws version control",
  "workspaces": [
    "shared",
    "backend-node",
    "frontend-unified"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev -w backend-node",
    "dev:frontend": "npm run dev -w frontend-unified",
    "demo": "bash scripts/demo.sh",
    "build": "npm run build:shared && npm run build:backend && npm run build:frontend",
    "build:shared": "npm run build -w shared",
    "build:backend": "npm run build -w backend-node",
    "build:frontend": "npm run build -w frontend-unified",
    "lint": "eslint . --max-warnings 0 && npm run lint:palette",
    "lint:palette": "bash scripts/check-palette.sh",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "test": "npm run test:shared && npm run test:backend && npm run test:frontend",
    "test:shared": "npm run test:run -w shared",
    "test:backend": "npm run test:run -w backend-node",
    "test:frontend": "npm run test:run -w frontend-unified",
    "test:coverage": "npm run test:coverage -w shared && npm run test:coverage -w backend-node && npm run test:coverage -w frontend-unified",
    "db:generate": "npm run db:generate -w backend-node",
    "db:migrate": "npm run db:migrate -w backend-node",
    "db:studio": "npm run db:studio -w backend-node",
    "e2e": "npm run build:shared && npm run build -w frontend-unified && playwright test -c e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.3.0",
    "pg": "^8.23.1",
    "prettier": "^3.8.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^8.3.2"
  },
  "overrides": {
    "shell-quote": "^1.12.0",
    "prisma": {
      "mysql2": "^3.24.5"
    },
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
