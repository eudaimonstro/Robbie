{
  "name": "robbie-bylawyer",
  "version": "1.0.0",
  "private": true,
  "description": "Combined parliamentary procedure application with bylaws version control",
  "workspaces": [
    "shared",
    "backend-node",
    "frontend-unified",
    "mobile"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev -w backend-node",
    "dev:frontend": "npm run dev -w frontend-unified",
    "build": "npm run build:shared && npm run build:backend && npm run build:frontend",
    "build:shared": "npm run build -w shared",
    "build:backend": "npm run build -w backend-node",
    "build:frontend": "npm run build -w frontend-unified",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "test": "npm run test:shared && npm run test:backend && npm run test:frontend && npm run test:mobile",
    "test:shared": "npm run test:run -w shared",
    "test:backend": "npm run test:run -w backend-node",
    "test:frontend": "npm run test:run -w frontend-unified",
    "test:mobile": "npm run test:run -w mobile",
    "test:coverage": "npm run test:coverage -w shared && npm run test:coverage -w backend-node",
    "db:generate": "npm run db:generate -w backend-node",
    "db:push": "npm run db:push -w backend-node",
    "db:migrate": "npm run db:migrate -w backend-node",
    "db:studio": "npm run db:studio -w backend-node"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^8.3.2"
  },
  "overrides": {
    "compression": "^1.8.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
