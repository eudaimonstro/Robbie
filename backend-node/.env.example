PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# Reverse proxies in front of the server, so the per-IP rate limits see the client's address in
# X-Forwarded-For. Unset or 0 trusts none: without a proxy, trusting one would let any client
# forge its address and dodge the limits. Production runs behind Caddy, so it sets 1.
# TRUST_PROXY=1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/robbie
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/robbie
# TLS to Postgres: disable, require (no certificate check) or verify. Unset, a database on this
# machine or in another container (a Compose service name such as "postgres") has no TLS, and any
# other host requires it. An sslmode in DATABASE_URL takes precedence.
# DATABASE_SSL=verify

# Test sign-in (development only, refused in production): the code 000000 signs in any email
# ENABLE_TEST_AUTH=true

# Email (Resend HTTPS API). Leave RESEND_API_KEY unset to log codes to the console in development.
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM="Robbie <noreply@robbie.scouch.dev>"
