PORT=3001
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=dev-secret-change-in-prod
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/robbie
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/robbie
# TLS to Postgres: disable, require (no certificate check) or verify. Unset, a database on this
# machine has no TLS and any other host requires it; an sslmode in DATABASE_URL takes precedence.
# A Postgres container reached by its Compose service name needs DATABASE_SSL=disable.
# DATABASE_SSL=disable

# Email (Resend HTTPS API). Leave RESEND_API_KEY unset to log codes to the console in development.
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM="Robbie <noreply@robbie.scouch.dev>"
