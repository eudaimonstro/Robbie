    "@prisma/client": "^7.10.0",
    "@robbie-bylawyer/shared": "file:../shared",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.0.15",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "resend": "^6.32.0",
    "socket.io": "^4.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "jszip": "^3.10.2",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
