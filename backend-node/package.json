{
  "name": "@robbie-bylawyer/backend-robbie",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest",
